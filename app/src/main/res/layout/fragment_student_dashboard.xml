<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- Top Header Toolbar Area -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="0dp"
        app:cardElevation="0dp"
        app:strokeWidth="1dp"
        app:strokeColor="@color/card_border"
        app:cardBackgroundColor="@color/background">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:paddingHorizontal="20dp">

            <TextView
                android:id="@+id/tv_student_welcome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:text="Welcome, Resident"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/on_background" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_student_logout"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                app:icon="@drawable/ic_logout"
                app:iconTint="@color/primary"
                app:iconSize="24dp"
                android:contentDescription="Logout" />
        </RelativeLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- TabLayout for switching panels -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/student_tab_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/background"
        app:tabMode="scrollable"
        app:tabSelectedTextColor="@color/primary"
        app:tabIndicatorColor="@color/primary">

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="My Room" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Complaints &amp; Leaves" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Fees &amp; Visitors" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Notices" />
    </com.google.android.material.tabs.TabLayout>

    <!-- Content panels -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- PANEL 1: Profile & Room Allocation Card -->
        <ScrollView
            android:id="@+id/panel_room_profile"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Room Allocation Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_my_room"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="28dp"
                    app:strokeWidth="0dp"
                    app:cardBackgroundColor="@color/sleek_purple_container"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="My Allocated Room Details"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/sleek_purple_on_container"
                            android:alpha="0.8"
                            android:layout_marginBottom="8dp" />

                        <TextView
                            android:id="@+id/tv_allocated_room_num"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Room Number: Not Allocated Yet"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            android:textColor="@color/sleek_purple_on_container" />

                        <TextView
                            android:id="@+id/tv_allocated_block"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Block: -"
                            android:textSize="14sp"
                            android:textColor="@color/sleek_purple_on_container"
                            android:alpha="0.9"
                            android:layout_marginTop="6dp" />

                        <TextView
                            android:id="@+id/tv_allocated_type"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Sharing Type: -"
                            android:textSize="14sp"
                            android:textColor="@color/sleek_purple_on_container"
                            android:alpha="0.9"
                            android:layout_marginTop="2dp" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Profile Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="16dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/sleek_border"
                    app:cardBackgroundColor="@color/white">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Resident Profile Particulars"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorPrimary"
                            android:layout_marginBottom="12dp" />

                        <TextView
                            android:id="@+id/tv_profile_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Name: -"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="@color/on_background" />

                        <TextView
                            android:id="@+id/tv_profile_reg"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Reg Number: -"
                            android:textSize="14sp"
                            android:textColor="@color/grey_800"
                            android:layout_marginTop="4dp" />

                        <TextView
                            android:id="@+id/tv_profile_dept"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Department: -"
                            android:textSize="14sp"
                            android:textColor="@color/grey_800"
                            android:layout_marginTop="2dp" />

                        <TextView
                            android:id="@+id/tv_profile_email"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Email: -"
                            android:textSize="14sp"
                            android:textColor="@color/grey_800"
                            android:layout_marginTop="2dp" />

                        <TextView
                            android:id="@+id/tv_profile_phone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Phone: -"
                            android:textSize="14sp"
                            android:textColor="@color/grey_800"
                            android:layout_marginTop="2dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_download_id"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Download Resident ID Card"
                            android:layout_marginTop="16dp" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </ScrollView>

        <!-- PANEL 2: Complaints & Leaves Forms -->
        <ScrollView
            android:id="@+id/panel_complaints_leaves"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Submit Complaint Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="14dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/card_border"
                    app:cardBackgroundColor="@color/white"
                    android:layout_marginBottom="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Report Maintenance / Support Issue"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorPrimary"
                            android:layout_marginBottom="8dp" />

                        <EditText
                            android:id="@+id/et_complaint_title"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:hint="Complaint Title (e.g. Broken Fan)"
                            android:paddingHorizontal="12dp"
                            android:background="@drawable/ic_launcher_background"
                            android:backgroundTint="@color/grey_100"
                            android:textSize="14sp" />

                        <EditText
                            android:id="@+id/et_complaint_category"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:hint="Category (Electricity, Water, Internet, etc.)"
                            android:layout_marginTop="8dp"
                            android:paddingHorizontal="12dp"
                            android:background="@drawable/ic_launcher_background"
                            android:backgroundTint="@color/grey_100"
                            android:textSize="14sp" />

                        <EditText
                            android:id="@+id/et_complaint_desc"
                            android:layout_width="match_parent"
                            android:layout_height="80dp"
                            android:hint="Add details of the issue..."
                            android:layout_marginTop="8dp"
                            android:gravity="top"
                            android:padding="12dp"
                            android:background="@drawable/ic_launcher_background"
                            android:backgroundTint="@color/grey_100"
                            android:textSize="14sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_submit_complaint"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Submit Support Request"
                            android:layout_marginTop="12dp" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Apply Leave Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="14dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/card_border"
                    app:cardBackgroundColor="@color/white">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Apply for Weekend / Emergency Leave"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorPrimary"
                            android:layout_marginBottom="8dp" />

                        <EditText
                            android:id="@+id/et_leave_start"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:hint="Start Date (YYYY-MM-DD)"
                            android:paddingHorizontal="12dp"
                            android:background="@drawable/ic_launcher_background"
                            android:backgroundTint="@color/grey_100"
                            android:textSize="14sp" />

                        <EditText
                            android:id="@+id/et_leave_end"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:hint="End Date (YYYY-MM-DD)"
                            android:layout_marginTop="8dp"
                            android:paddingHorizontal="12dp"
                            android:background="@drawable/ic_launcher_background"
                            android:backgroundTint="@color/grey_100"
                            android:textSize="14sp" />

                        <EditText
                            android:id="@+id/et_leave_dest"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:hint="Travel Destination"
                            android:layout_marginTop="8dp"
                            android:paddingHorizontal="12dp"
                            android:background="@drawable/ic_launcher_background"
                            android:backgroundTint="@color/grey_100"
                            android:textSize="14sp" />

                        <EditText
                            android:id="@+id/et_leave_reason"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:hint="Reason for Leave"
                            android:layout_marginTop="8dp"
                            android:paddingHorizontal="12dp"
                            android:background="@drawable/ic_launcher_background"
                            android:backgroundTint="@color/grey_100"
                            android:textSize="14sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_apply_leave"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Submit Leave Form"
                            android:layout_marginTop="12dp" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </ScrollView>

        <!-- PANEL 3: Fees & Visitor Request Passes -->
        <ScrollView
            android:id="@+id/panel_fees_visitors"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Submit Visitor Pass -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="14dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/card_border"
                    app:cardBackgroundColor="@color/white"
                    android:layout_marginBottom="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Request Visitor Access Pass"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorPrimary"
                            android:layout_marginBottom="8dp" />

                        <EditText
                            android:id="@+id/et_visitor_name"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:hint="Visitor Full Name"
                            android:paddingHorizontal="12dp"
                            android:background="@drawable/ic_launcher_background"
                            android:backgroundTint="@color/grey_100"
                            android:textSize="14sp" />

                        <EditText
                            android:id="@+id/et_visitor_relation"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:hint="Relation (e.g. Brother, Father)"
                            android:layout_marginTop="8dp"
                            android:paddingHorizontal="12dp"
                            android:background="@drawable/ic_launcher_background"
                            android:backgroundTint="@color/grey_100"
                            android:textSize="14sp" />

                        <EditText
                            android:id="@+id/et_visitor_cnic"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:hint="CNIC Number of Visitor"
                            android:layout_marginTop="8dp"
                            android:paddingHorizontal="12dp"
                            android:background="@drawable/ic_launcher_background"
                            android:backgroundTint="@color/grey_100"
                            android:textSize="14sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_request_visitor"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Submit Pass Request"
                            android:layout_marginTop="12dp" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Outstanding Fees Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_fee_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="14dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/card_border"
                    app:cardBackgroundColor="@color/white">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="My Unpaid Fees Summary"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorPrimary"
                            android:layout_marginBottom="8dp" />

                        <TextView
                            android:id="@+id/tv_unpaid_fee_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Pending Dues: None"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@color/success" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_pay_dues_mock"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Simulate Fee Payment Offline"
                            android:layout_marginTop="12dp"
                            android:visibility="gone" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </ScrollView>

        <!-- PANEL 4: Notices Board List -->
        <LinearLayout
            android:id="@+id/panel_notices"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Official Broadcasts"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/on_background"
                android:layout_marginBottom="12dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_student_notices"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </LinearLayout>

    </FrameLayout>
</LinearLayout>
